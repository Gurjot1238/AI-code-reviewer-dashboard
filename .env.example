# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep "/reviewbot" before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/reviewbot?retryWrites=true&w=majority

# Google Gemini API key for AI reviews (free: https://aistudio.google.com/apikey)
# Leave it as is and the app uses the built-in rule engine instead.
GEMINI_API_KEY=<paste-your-gemini-key>
# Optional: force a specific model, e.g. GEMINI_MODEL=gemini-2.5-flash (otherwise picked automatically)
# GEMINI_MODEL=

# Optional: GitHub token for repo scans (raises rate limit from 60 to 5000 requests/hour)
# GITHUB_TOKEN=

# Max files reviewed per repo scan
SCAN_MAX_FILES=25

PORT=3000
# JWT_SECRET is created automatically on first run

# Email of the account that should be an admin (comma-separate for more than one).
# It becomes admin when it signs up or next logs in. Admins can make others reviewers or admins.
ADMIN_EMAIL=
